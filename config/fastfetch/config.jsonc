{
  "logo": {
    "type": "small"
  },
  "display": {
    "color": {
      "title": "#7aa2f7",
      "keys": "#bb9af7"
    }
  },
  "modules": [
    "title",
    { "type": "separator", "string": "─" },
    {
      "type": "datetime",
      "key": "Date",
      "format": "{weekday}, {month-name-short} {day-in-month}"
    },
    "os",
    "host",
    "shell",
    "terminal",
    "uptime",
    "memory"
  ]
}
