{
  "logo": {
    "type": "small",
    "color": {
      "1": "38;2;167;192;128",
      "2": "38;2;219;188;127"
    }
  },
  "display": {
    "color": {
      "title": "#a7c080",
      "keys": "#8fc9a0",
      "separator": "#97a093",
      "output": "#e6dfcb"
    },
    "key": {
      "width": 9
    }
  },
  "modules": [
    "title",
    { "type": "separator", "string": "─" },
    {
      "type": "datetime",
      "key": "Date",
      "format": "{weekday}, {month-name-short} {day-in-month}"
    },
    "os",
    "host",
    "shell",
    "terminal",
    "uptime",
    "memory"
  ]
}
